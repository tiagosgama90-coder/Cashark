PORT=8787
ADMIN_KEY=change-me-admin-key

# ── YOU RECEIVE MONEY (shop) — same Stripe account as your other project is OK ──
# Dashboard → Developers → API keys (use Restricted key or Secret key for Cashark)
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard → Developers → Webhooks → endpoint https://YOUR-API/v1/webhooks/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxx
PUBLIC_APP_URL=https://cashark.app
API_PUBLIC_URL=https://YOUR-API-HOST

# ── YOU PAY USERS (cashout) — PayPal Payouts only needs to be enabled if you auto-pay ──
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
AUTO_PAY_PAYPAL=true

DATA_DIR=./data
